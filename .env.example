# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# PostgreSQL (sesuaikan dengan database di pgAdmin 4)
DATABASE_URL=postgresql://postgres:password@localhost:5432/risss_clobber
# Alternatif parameter terpisah:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=risss_clobber
# PGUSER=postgres
# PGPASSWORD=password
